# LUMA Backend Environment Variables
# Node 2: Backend + Database (192.168.1.20)

PORT=5000
HOST=0.0.0.0

# Secret keys for sessions and JWT signatures
SECRET_KEY=replace-with-a-random-secret-key-in-production
JWT_SECRET=replace-with-a-strong-jwt-secret-key

# Database Connection (SQLite default, can be PostgreSQL in production)
DATABASE_URI=sqlite:///luma.db

# Stability Matrix AI Server URL (Node 3: 192.168.1.30:7860)
AI_SERVER_URL=http://192.168.1.30:7860
AI_TIMEOUT_SECONDS=15

# AI Client Mode:
# Set to 'true' to simulate image generation without requiring a running GPU server
# Set to 'false' in production with a live Stability Matrix server
AI_MOCK_MODE=false

# If AI Server fails or is unreachable, allow seamless mock image fallback
AI_ALLOW_FALLBACK_MOCK=true
